(executable
 (name run_tests)
 (libraries
  logtk
  logtk.parsers
  logtk.arbitrary
  logtk.arith
  libzipperposition
  iter
  qcheck-core
  qcheck-alcotest
  alcotest)
 (flags :standard -warn-error -3 -w -3-50 -color always -open Logtk_arith))

(rule
 (alias runtest)
 (package logtk)
 (locks /tlock)
 (deps run_tests.exe)
 (action
  (run %{deps})))

; Regression test: prove two easy files in a single CLI call.
; Guards per-file state isolation.

(rule
 (alias runtest)
 (action
  (run
   %{bin:zipperposition}
   %{dep:regressions/multi_input/easy1.p}
   %{dep:regressions/multi_input/easy2.p})))

; Regression test: custom queue weight functions receive the queue context
; (`on_init`, `related_terms`) explicitly and work for each file in one CLI
; call. Guards nzbg.

(rule
 (alias runtest)
 (targets queue_ctx_multi.out)
 (action
  (progn
   (with-outputs-to
    queue_ctx_multi.out
    (run
     %{bin:zipperposition}
     --check
     --add-queue
     "3|prefer-fo|conjecture-relative-var(1.02,l,f)"
     --add-queue
     "1|prefer-processed|fifo"
     --add-queue
     "3|prefer-sos|conj_pref_weight(1,0,1,1,1)"
     %{dep:regressions/multi_input/easy1.p}
     %{dep:regressions/multi_input/easy2.p}))
   (system "test $(grep -c 'SZS status Theorem' queue_ctx_multi.out) -eq 2"))))

; Regression test: `--check-lambda-free=only` runs the fragment check at
; [on_start] and prints its verdict, i.e. the hook is registered before the
; signal is sent. Guards q3qh.

(rule
 (alias runtest)
 (targets lambda_free.out)
 (action
  (progn
   (with-outputs-to
    %{targets}
    (run
     %{bin:zipperposition}
     --check-lambda-free=only
     %{dep:regressions/lambda_free/lambda.p}))
   (run grep -q "Problem in fragment" %{targets}))))

; Regression test: `-p`/`--progress`/`--no-progress` reach `Params.t`, i.e.
; the CLI handlers write refs that [parse_args] reads after [Arg.parse].
; Guards shxy.

(rule
 (alias runtest)
 (targets progress.out no_progress.out)
 (action
  (progn
   (with-outputs-to
    progress.out
    (run %{bin:zipperposition} -p %{dep:regressions/multi_input/easy1.p}))
   (run grep -q "steps" progress.out)
   (with-outputs-to
    no_progress.out
    (run
     %{bin:zipperposition}
     --progress
     --no-progress
     %{dep:regressions/multi_input/easy1.p}))
   (system "! grep -q steps no_progress.out"))))

; Regression test: AC state is per-Env. Two files with the same AC symbol in
; one CLI call must each get their own AC table and rules. Guards 9m9f.

(rule
 (alias runtest)
 (targets ac_multi.out)
 (action
  (progn
   (with-outputs-to
    ac_multi.out
    (run
     %{bin:zipperposition}
     --check
     %{dep:regressions/multi_input/ac1.zf}
     %{dep:regressions/multi_input/ac2.zf}))
   (system "test $(grep -c 'SZS status Theorem' ac_multi.out) -eq 2")
   (system
    "awk '/SZS status Theorem/ { n++ } n == 2 && /ac1.zf/ { bad = 1 } n == 2 && /AC.normalize/ { norm = 1 } END { exit (n < 2 || bad || !norm) }' ac_multi.out"))))

; Regression test: Name_payload is cleared per file. Two files declaring the
; same datatype in one CLI call must both be processed. Guards fcxr.

(rule
 (alias runtest)
 (targets datatype_multi.out)
 (action
  (progn
   (with-outputs-to
    datatype_multi.out
    (run
     %{bin:zipperposition}
     --check
     %{dep:regressions/multi_input/datatype1.smt2}
     %{dep:regressions/multi_input/datatype2.smt2}))
   (system "test $(grep -c 'SZS status' datatype_multi.out) -eq 2")
   (system "! grep -q 'already declared' datatype_multi.out"))))

; Regression test: enum type state is per-Env. Two files declaring the same
; type name with different cases must each use their own declaration. Guards 2d89.

(rule
 (alias runtest)
 (targets enum_multi.out)
 (action
  (progn
   (with-outputs-to
    enum_multi.out
    (run
     %{bin:zipperposition}
     --enum-types
     %{dep:regressions/multi_input/enum1.p}
     %{dep:regressions/multi_input/enum2.p}))
   (system "test $(grep -c 'SZS status Theorem' enum_multi.out) -eq 2"))))

; Regression test: lambda-lifting index is per-Env. Two files with the same
; lambda must each lift it locally, not reuse the first file's definition.
; Guards r3qf.

(rule
 (alias runtest)
 (targets lambda_multi.out)
 (action
  (progn
   (with-outputs-to
    lambda_multi.out
    (run
     %{bin:zipperposition}
     --live-lambda-lifting
     true
     --post-cnf-lambda-lifting
     true
     %{dep:regressions/multi_input/lambda1.p}
     %{dep:regressions/multi_input/lambda2.p}))
   (system
    "awk '/SZS status/ { n++ } n == 2 && /lambda1.p/ { bad = 1 } END { exit (n < 2 || bad) }' lambda_multi.out"))))

; Regression test: higher-order extensionality state is per-Env. Two files
; with the same negative extensionality literal must each create their own
; skolems. Guards kfrf.

(rule
 (alias runtest)
 (targets ho_state_multi.out)
 (action
  (progn
   (with-outputs-to
    ho_state_multi.out
    (run
     %{bin:zipperposition}
     --ho-ext-neg-lit
     true
     %{dep:regressions/multi_input/ho1.p}
     %{dep:regressions/multi_input/ho2.p}))
   (system
    "awk '/SZS status/ { n++ } n == 2 && /fresh_sk1/ { bad = 1 } END { exit (n < 2 || bad) }' ho_state_multi.out"))))

; Regression test: Avatar and induction state is per-Env. Two files using
; splitting and induction in one CLI call must each be processed, and each
; Env's lemma table must contain only its own input lemma. Guards rcmh.

(rule
 (alias runtest)
 (targets avatar_multi.out)
 (action
  (progn
   (with-outputs-to
    avatar_multi.out
    (run
     %{bin:zipperposition}
     --avatar=eager
     --induction
     --print-lemmas
     %{dep:regressions/multi_input/avatar1.zf}
     %{dep:regressions/multi_input/avatar2.zf}))
   (system "test $(grep -c 'SZS status Theorem' avatar_multi.out) -eq 2")
   (system "test $(grep -c ':reason in-input' avatar_multi.out) -eq 2")
   (system
    "awk '/SZS status/ { n++ } n == 2 && /avatar1.zf/ { bad = 1 } END { exit (n < 2 || bad) }' avatar_multi.out"))))

; Regression test: BCE, PredElim, and their fixpoint extension can be enabled
; together without duplicate setup or shared-state interference. Guards 36sd.

(rule
 (alias runtest)
 (targets bce_pe_fixpoint.out)
 (action
  (progn
   (with-outputs-to
    bce_pe_fixpoint.out
    (run
     %{bin:zipperposition}
     --avatar=off
     --bce
     true
     --pred-elim
     true
     --bce-pe-fixpoint
     true
     %{dep:regressions/bce_pe_fixpoint.p}))
   (run grep -q "SZS status Theorem" bce_pe_fixpoint.out))))

; Regression test: the inprocessing fixpoint setup must not register BCE's
; [initialize_regular] a second time when standalone BCE is already enabled.
; Guards 36sd.

(rule
 (alias runtest)
 (targets bce_pe_fixpoint_inprocessing.out)
 (action
  (progn
   (with-outputs-to
    bce_pe_fixpoint_inprocessing.out
    (run
     %{bin:zipperposition}
     --avatar=off
     --bce
     true
     --pred-elim
     true
     --bce-pe-fixpoint
     true
     --bce-pe-fixpoint-inprocessing
     true
     %{dep:regressions/bce_pe_fixpoint.p}))
   (run grep -q "SZS status Theorem" bce_pe_fixpoint_inprocessing.out)
   (system
    "test $(grep -c '% BCE start:' bce_pe_fixpoint_inprocessing.out) -eq 1"))))

; Regression test: the clause queue is initialized before initial clauses are
; inserted, so `rel_lvl_weight` sees them. Guards pwbw.

(rule
 (alias runtest)
 (targets queue_init.out)
 (action
  (progn
   (with-outputs-to
    queue_init.out
    (run
     %{bin:zipperposition}
     -q
     "2|prefer-processed|rel_lvl_weight(0,1,2,1,1,1,200,200,2.5,999,999)"
     %{dep:regressions/multi_input/easy1.p}))
   (run grep -q "SZS status Theorem" queue_init.out))))

; Regression test: rel_lvl_weight tables are per-queue. Swapping the order of
; two problems must not change any computed clause weight. Guards 258r.

(rule
 (alias runtest)
 (targets queue_rel_lvl_multi.out)
 (deps
  regressions/multi_input/enum1.p
  regressions/multi_input/enum2.p
  queue_rel_lvl_multi.sh)
 (action
  (with-stdout-to
   queue_rel_lvl_multi.out
   (run
    sh
    %{dep:queue_rel_lvl_multi.sh}
    %{bin:zipperposition}
    %{dep:regressions/multi_input/enum1.p}
    %{dep:regressions/multi_input/enum2.p}))))

; Regression test: --sat-log is applied after CLI parsing, so the log file is
; actually populated. Guards 0a3a.

(rule
 (alias runtest)
 (targets sat_log.out sat_log.log)
 (action
  (progn
   (with-outputs-to
    sat_log.out
    (run
     %{bin:zipperposition}
     --sat-log
     sat_log.log
     %{dep:regressions/multi_input/easy1.p}))
   (run test -s sat_log.log))))

; Regression test: max-vars flags are argument-less. Guards qse1.

(rule
 (alias runtest)
 (targets max_vars_flags.out)
 (action
  (progn
   (with-outputs-to
    max_vars_flags.out
    (run
     %{bin:zipperposition}
     --no-max-vars
     --enable-max-vars
     %{dep:regressions/multi_input/easy1.p}))
   (run grep -q "SZS status Theorem" max_vars_flags.out))))

