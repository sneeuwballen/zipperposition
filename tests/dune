(executable
 (name run_tests)
 (libraries
  logtk
  logtk.parsers
  logtk.arbitrary
  logtk.arith
  iter
  qcheck-core
  qcheck-alcotest
  alcotest)
 (flags :standard -warn-error -3 -w -3-50 -color always -open Logtk_arith))

(rule
 (alias runtest)
 (package logtk)
 (locks /tlock)
 (deps run_tests.exe)
 (action
  (run %{deps})))

; Regression test: prove two easy files in a single CLI call.
; Guards per-file state isolation (see 2026-07-23-fixes.md). Currently FAILS
; (binary exits 1: file 2 crashes with Not_found) until the global-state
; reset fix lands; passes (exit 0) once both files prove.
(rule
 (alias runtest)
 (action
  (run %{bin:zipperposition}
   %{dep:regressions/multi_input/easy1.p}
   %{dep:regressions/multi_input/easy2.p})))
