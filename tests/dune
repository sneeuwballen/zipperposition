(executable
 (name run_tests)
 (libraries
  logtk
  logtk.parsers
  logtk.arbitrary
  logtk.arith
  libzipperposition
  iter
  qcheck-core
  qcheck-alcotest
  alcotest)
 (flags :standard -warn-error -3 -w -3-50 -color always -open Logtk_arith))

(rule
 (alias runtest)
 (package logtk)
 (locks /tlock)
 (deps run_tests.exe)
 (action
  (run %{deps})))

; Regression test: prove two easy files in a single CLI call.
; Guards per-file state isolation.

(rule
 (alias runtest)
 (action
  (run
   %{bin:zipperposition}
   %{dep:regressions/multi_input/easy1.p}
   %{dep:regressions/multi_input/easy2.p})))
